# Copy these into your hosting provider's "Environment" settings (never commit real values).

# Long random text used to sign login tokens (required in production)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# PostgreSQL connection (leave EMPTY to use the built-in H2 file database for local testing)
# Accepted: postgres://USER:PASSWORD@HOST:5432/DBNAME   or   jdbc:postgresql://HOST:5432/DBNAME (+ DB_USERNAME, DB_PASSWORD)
DATABASE_URL=

# The four private admin accounts (admins cannot register on the website)
ADMIN1_USERNAME=bharath
ADMIN1_PASSWORD=CHANGE_ME_1
ADMIN1_NAME=T. Bharath Kumar
ADMIN1_EMAIL=bharath@ceagap.local

ADMIN2_USERNAME=sajeev
ADMIN2_PASSWORD=CHANGE_ME_2
ADMIN2_NAME=B. Sajeev
ADMIN2_EMAIL=sajeev@ceagap.local

ADMIN3_USERNAME=bindhu
ADMIN3_PASSWORD=CHANGE_ME_3
ADMIN3_NAME=V. Bindhu
ADMIN3_EMAIL=bindhu@ceagap.local

ADMIN4_USERNAME=navadeepika
ADMIN4_PASSWORD=CHANGE_ME_4
